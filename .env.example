# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# LiveKit room server. Free dev project at https://cloud.livekit.io, or run
# `livekit-server --dev` locally and use ws://localhost:7880.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# STT
DEEPGRAM_API_KEY=

# LLM (free tier, no billing required: console.groq.com)
GROQ_API_KEY=

# TTS -- the provider under test. Get a key at https://rime.ai.
RIME_API_KEY=

# Optional overrides (defaults live in state.py / tools.py / web_server.py)
# DATAFORGE_LOOKUP_DELAY=3.0
# DATAFORGE_FENCING_ENABLED=true
# DATAFORGE_ROOM_NAME=clinic-call
# DATAFORGE_WEB_PORT=8080
